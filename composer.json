{
    "name": "cscli/cli",
    "description": "Command-line client for the CSCLI source code retrieval API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "symfony/console": "^7.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "Cscli\\": "src/"
        }
    },
    "bin": [
        "bin/cscli"
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
